{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(python scripts/validate_skill.py:*)",
      "Bash(python scripts/audit_skill.py:*)",
      "Bash(python3 scripts/validate_skill.py:*)",
      "Bash(python3 scripts/audit_skill.py:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
